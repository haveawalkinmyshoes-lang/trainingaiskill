# Ключ можно вместо файла ввести в настройках интерфейса. Не отправляйте его в чат.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
AI_API_STYLE=responses
PORT=8765
# Список допуска хранится только на сервере, вне Git и public/.
# EMPLOYEE_ALLOWLIST_FILE=/etc/secrets/employees.json
# Формат JSON-файла: массив полных ФИО либо объектов {"fullName":"...","enabled":true}.
# Для кода нужны объекты {"fullName":"Фамилия Имя","email":"user@example.com"}.
BITRIX_MCP_URL=https://bitrix24-mcp-v592.onrender.com/mcp
MCP_AUTH_TOKEN=

# Отдельный административный ключ MCP, не ключ Битрикс24. Минимум 32 символа.
TRAINER_BRIDGE_TOKEN=
# Необязательно: управление только заданным сервисом Render.
RENDER_API_KEY=
RENDER_SERVICE_ID=
TRAINER_BRIDGE_ALLOW_DEPLOY=false
